    <string name="live_requests_channel_name">Live location requests</string>
    <string name="live_requests_channel_description">Keeps a connection open so family can request your current location.</string>
    <string name="live_requests_notification_title">Listening for location requests</string>
    <string name="live_requests_notification_text">Family can tap Refresh to get your current location.</string>
    <string name="live_requests">Live requests</string>
    <string name="live_requests_on">Live requests: On</string>
    <string name="live_requests_off">Live requests: Off</string>
    <string name="live_requests_dialog_message">When on, the app keeps a low-power connection open in the background (shown as a silent notification) so family can tap Refresh to get your current location. When off, your location still updates as you move, but Refresh won\'t work for you.</string>
    <string name="turn_on">Turn on</string>
    <string name="turn_off">Turn off</string>
    <string name="unsupported">Unsupported</string>
    <string name="checking_ellipsis">Checking…</string>
    <string name="why_unsupported">Why is on-demand refresh unsupported?</string>
    <string name="unsupported_title">Why is on-demand refresh unsupported?</string>
    <string name="unsupported_iphone_body">%1$s\'s iPhone isn\'t listening for requests right now. Zood\'s servers can\'t wake an iPhone, so the app has to stay running in the background to hear one. That stops if Live Requests is off, or if the app was swiped closed.\n\nTheir location still updates on its own whenever they move. To enable Refresh, %1$s can open the app (and turn on Live Requests with location access \"Always\" if it\'s off).</string>
    <string name="unsupported_android_body">%1$s uses an Android phone with Live Requests turned off, so it isn\'t listening for requests.\n\nTheir location still updates on its own whenever they move. Refresh comes back once %1$s turns on Live Requests in the Family Locator app\'s settings on their Android phone.</string>
    <string name="unrestricted_battery_title">Allow unrestricted battery usage</string>
    <string name="unrestricted_battery_needed">Allow unrestricted battery usage for reliable location sharing.</string>
    <string name="unrestricted_battery_message">Family Locator needs unrestricted battery usage to keep sharing your location and receive refresh requests while your phone is idle. This may use more battery.\n\nTap System settings, then Allow if Android asks to stop optimizing battery usage. If app settings open, choose Battery (or App battery usage) and select Unrestricted or Allow background usage. Labels vary by phone.</string>

