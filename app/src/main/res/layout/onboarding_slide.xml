<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            tools:src="@drawable/onboarding_add_friends" />

        <TextView
            android:id="@+id/title"
            style="@style/Zood.Headline5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            tools:text="@string/onboarding_title_2" />

        <TextView
            android:id="@+id/body"
            style="@style/Zood.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            tools:text="@string/onboarding_body_2" />

        <LinearLayout
            android:id="@+id/sharing_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/default_sharing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/share_with_new_friends" />

            <TextView
                style="@style/Zood.Body2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/share_with_new_friends_explanation" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
