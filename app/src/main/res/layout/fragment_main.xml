<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <xyz.zood.george.widget.SlidableCL
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/surface"
        tools:context=".MainFragment">

        <org.maplibre.android.maps.MapView
            android:id="@+id/map"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:elevation="0dp"
            android:outlineProvider="bounds"
            android:transformPivotX="0px"
            app:maplibre_foregroundLoadColor="@color/map_placeholder"
            app:layout_constraintBottom_toTopOf="@+id/friends_bar_fragment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@android:color/holo_green_light"/>

        <xyz.zood.george.widget.BannerView
            android:id="@+id/banners"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            android:elevation="4dp"
            tools:layout_height="48dp"
            tools:background="@color/zood_red"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/info_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/surface"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:paddingBottom="12dp"
            android:translationX="-1000dp"
            tools:translationX="0dp"
            app:layout_constraintBottom_toTopOf="@id/friends_bar_fragment"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/top_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="9dp" />

            <ProgressBar
                android:id="@+id/refresh_progress_bar"
                style="@style/Base.Widget.AppCompat.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:layout_constraintBottom_toTopOf="@id/top_guideline"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/username"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:textColor="@color/text_primary"
                style="@style/Zood.Headline6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@id/friend_platform"
                tools:text="arash" />

            <FrameLayout
                android:id="@+id/nickname_editor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/info_overflow" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/name_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:barrierAllowsGoneWidgets="false"
                app:constraint_referenced_ids="username,nickname_editor" />

            <!-- Platform logo and edit pencil sit just left of the ⋮ and × buttons, so a long name
                 wraps against the icons instead of having them pushed along behind its text. -->

            <ImageButton
                android:id="@+id/edit_nickname"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_edit_24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit_nickname"
                app:tint="@color/text_secondary"
                app:layout_constraintEnd_toStartOf="@id/info_overflow"
                app:layout_constraintTop_toTopOf="@id/info_overflow"
                app:layout_constraintBottom_toBottomOf="@id/info_overflow" />
            <ImageView
                android:id="@+id/friend_platform"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintEnd_toStartOf="@id/edit_nickname"
                app:layout_constraintTop_toTopOf="@id/edit_nickname"
                app:layout_constraintBottom_toBottomOf="@id/edit_nickname"
                app:tint="@color/text_tertiary" />
            <ImageView
                android:id="@+id/motion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                app:tint="@color/text_tertiary"
                app:layout_constraintStart_toEndOf="@id/battery"
                app:layout_constraintTop_toTopOf="@id/battery_icon"
                app:layout_constraintBottom_toBottomOf="@id/battery_icon"
                tools:src="@drawable/ic_sharp_walk_20dp" />

            <ImageView
                android:id="@+id/bearing"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_sharp_navigation_20dp"
                app:tint="@color/text_tertiary"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toEndOf="@id/motion"
                app:layout_constraintTop_toTopOf="@id/battery_icon"
                app:layout_constraintBottom_toBottomOf="@id/battery_icon"/>

            <ImageView
                android:id="@+id/battery_icon"
                android:contentDescription="@null"
                android:layout_width="wrap_content"
                android:layout_height="0dp"

                android:layout_marginTop="6dp"
                android:src="@drawable/ic_sharp_battery_50_20dp"
                app:tint="@color/zood_green"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/name_bottom" />

            <TextView
                android:id="@+id/battery"
                android:gravity="center_vertical"
                android:fontFamily="sans-serif"
                android:textColor="@color/zood_green"
                android:textSize="12sp"
                android:textStyle="normal"
                android:lineSpacingExtra="6sp"
                tools:text="50%"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginStart="4dp"
                app:layout_constraintTop_toTopOf="@id/battery_icon"
                app:layout_constraintBottom_toBottomOf="@id/battery_icon"
                app:layout_constraintStart_toEndOf="@id/battery_icon" />

            <ImageButton
                android:id="@+id/info_overflow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@null"
                android:padding="8dp"
                android:paddingBottom="6dp"
                android:src="@drawable/ic_sharp_more_vert_24dp"
                app:tint="@color/text_secondary"
                app:layout_constraintEnd_toStartOf="@id/info_close"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Family Locator: close button, same size and padding as the overflow button -->
            <ImageButton
                android:id="@+id/info_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="@string/close"
                android:padding="8dp"
                android:paddingBottom="6dp"
                android:src="@drawable/ic_close_black_24dp"
                app:tint="@color/text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackground"
                android:minHeight="32dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="16dp"
                android:textColor="@color/text_secondary"
                style="@style/Zood.Caption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/battery_icon"
                tools:text="1212 S. Westlake Blvd, Thousand Oaks" />

            <LinearLayout
                android:id="@+id/status_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/address">

                <LinearLayout
                    android:id="@+id/status_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/status_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check_black_24dp"
                        android:visibility="gone"
                        app:tint="@color/zood_green" />

                    <TextView
                        android:id="@+id/status_text"
                        style="@style/Zood.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_tertiary"
                        tools:text="Updated 25 min. ago" />
                </LinearLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/unsupported_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/unsupported_label"
                        style="@style/Zood.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/on_demand_refresh_unsupported"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_secondary"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintBottom_toBottomOf="@id/unsupported_info"
                        app:layout_constraintEnd_toStartOf="@id/unsupported_info"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/unsupported_info" />

                    <ImageButton
                        android:id="@+id/unsupported_info"
                        android:layout_width="36dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/why_unsupported"
                        android:src="@drawable/ic_help_outline_20dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/unsupported_label"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:tint="@color/zood_blue_dark" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>

            <!-- Icon-only Refresh; the status row above already says what's happening. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/refresh_button"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minWidth="64dp"
                android:contentDescription="@string/refresh_location"
                android:enabled="true"
                android:visibility="invisible"
                tools:visibility="visible"
                app:icon="@drawable/ic_refresh_24dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="16dp"
                app:layout_constraintTop_toBottomOf="@id/status_row" />


            <TextView
                android:id="@+id/share_switch_label"
                android:text="@string/sharing"
                style="@style/Zood.Body2"
                app:layout_constraintEnd_toStartOf="@id/share_switch"
                app:layout_constraintTop_toTopOf="@id/share_switch"
                app:layout_constraintBottom_toBottomOf="@id/share_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/share_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:checked="true"
                app:layout_constraintTop_toTopOf="@id/refresh_button"
                app:layout_constraintBottom_toBottomOf="@id/refresh_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:switchPadding="8dp"
                app:thumbTint="@color/switch_thumb"
                app:trackTint="@color/switch_track" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/settings"
            android:contentDescription="@string/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:src="@drawable/ic_settings_24dp"
            android:backgroundTint="@color/fab_background"
            android:foreground="@drawable/map_button_outline"
            app:tint="@color/text_secondary"
            app:rippleColor="@color/zood_blue"
            android:transformPivotX="0px"
            app:borderWidth="0dp"
            android:elevation="4dp"
            app:fabSize="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/banners" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/my_location_fab"
            android:contentDescription="@string/my_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:backgroundTint="@color/fab_background"
            android:foreground="@drawable/map_button_outline"
            android:src="@drawable/ic_my_location_black_24dp"
            app:tint="@color/my_location_fab_tint"
            app:rippleColor="@color/zood_blue"
            android:transformPivotX="0px"
            app:borderWidth="0dp"
            app:elevation="4dp"
            app:fabSize="normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/settings"
            tools:layout_editor_absoluteX="280dp" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/timed_share_fab"
            android:contentDescription="@string/timed_share"
            android:src="@drawable/ic_pin"
            android:backgroundTint="@color/timed_share_fab_background"
            android:foreground="@drawable/timed_share_fab_outline"
            tools:visibility="invisible"
            app:tint="@color/timed_share_fab_tint"
            app:rippleColor="@color/zood_blue"
            app:fabSize="normal"
            app:elevation="4dp"
            app:borderWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/friends_bar_fragment"
            android:layout_margin="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <fragment
            android:id="@+id/timed_share_fragment"
            android:name="xyz.zood.george.TimedShareFragment"
            app:layout_constraintTop_toTopOf="@id/friends_bar_fragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <fragment
            android:id="@+id/friends_bar_fragment"
            android:name="xyz.zood.george.FriendBarFragment"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="match_parent"
            android:layout_height="64dp" />

    </xyz.zood.george.widget.SlidableCL>
</layout>