<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="52dp"
    android:layout_height="64dp">
    <ImageView
        android:id="@+id/image"
        android:contentDescription="@string/add_friend"
        android:background="@color/surface_high"
        android:src="@drawable/ic_sharp_person_add_24dp"
        android:tint="@color/action_blue"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="4dp"
        android:scaleType="center"
        android:elevation="6dp"
        android:layout_width="40dp"
        android:layout_height="40dp" />
    <TextView
        android:id="@+id/bar_tile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:paddingHorizontal="2dp"
        android:text="@string/bar_add"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />
</FrameLayout>
